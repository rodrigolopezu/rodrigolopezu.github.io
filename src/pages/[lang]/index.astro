---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import upcLogo from '../../assets/upc.png';
import { languages, ui, other, homeUrl, projectUrl, splitId, formatDate, site, type Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui[lang];

const projects = (await getCollection('projects', (e) => splitId(e.id).lang === lang && !e.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base lang={lang} altHref={homeUrl(other(lang))}>
  <section class="hero">
    <h1>{site.name}<span class="cursor" aria-hidden="true"></span></h1>
    <p class="role">{t.role}</p>
    <p class="place mono dim">
      <Image class="upc-logo" src={upcLogo} alt="UPC" height={32} />
      {t.place}
    </p>
    <p class="intro">{t.intro}</p>
    <div class="links">
      <a class="btn primary" href={site.github}>{t.github} ↗</a>
      <a class="btn" href={site.linkedin}>LinkedIn ↗</a>
    </div>
  </section>

  <section id="projects" aria-labelledby="projects-title">
    <h2 class="section-title" id="projects-title">{t.projects}</h2>
    {
      projects.length === 0 ? (
        <p class="empty dim">{t.empty}</p>
      ) : (
        <div class="entries">
          {projects.map((p) => (
            <a class="entry" href={projectUrl(lang, splitId(p.id).slug)}>
              {p.data.cover && <Image class="cover" src={p.data.cover} alt="" width={720} />}
              <div class="body">
                <time class="mono dim" datetime={p.data.date.toISOString()}>
                  {formatDate(p.data.date, lang)}
                </time>
                <h3>{p.data.title}</h3>
                {p.data.facts.length > 0 && <p class="facts mono accent">{p.data.facts.join(' · ')}</p>}
                <p class="summary">{p.data.summary}</p>
                {p.data.tags.length > 0 && <p class="tags mono dim">{p.data.tags.join(' · ')}</p>}
              </div>
            </a>
          ))}
        </div>
      )
    }
  </section>
</Base>
