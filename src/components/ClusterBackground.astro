<canvas id="bg" aria-hidden="true"></canvas>

<script>
  // Scattered points drift on their own. Near the pointer they run the assignment
  // step of k-means: three centroids orbit the cursor and every point nearby
  // joins its closest one.
  const canvas = document.getElementById('bg') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const K = 3;
  const RADIUS = 200;
  const ORBIT = 62;
  const SPREAD = 26;

  type Point = {
    hx: number;
    hy: number;
    x: number;
    y: number;
    ox: number;
    oy: number;
    phase: number;
    speed: number;
    mix: number;
  };

  let points: Point[] = [];
  let w = 0;
  let h = 0;
  let accent = '#39ff88';
  const pointer = { x: -1e4, y: -1e4, active: false, fade: 0 };

  const readAccent = () => {
    accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || accent;
  };

  const rgba = (hex: string, a: number) => {
    const n = parseInt(hex.replace('#', ''), 16);
    return `rgba(${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}, ${a})`;
  };

  function resize() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    w = window.innerWidth;
    h = window.innerHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const count = Math.max(40, Math.min(170, Math.round((w * h) / 9000)));
    points = Array.from({ length: count }, () => {
      const hx = Math.random() * w;
      const hy = Math.random() * h;
      const angle = Math.random() * Math.PI * 2;
      const dist = Math.sqrt(Math.random()) * SPREAD;
      return {
        hx,
        hy,
        x: hx,
        y: hy,
        ox: Math.cos(angle) * dist,
        oy: Math.sin(angle) * dist,
        phase: Math.random() * Math.PI * 2,
        speed: 0.0004 + Math.random() * 0.0006,
        mix: 0,
      };
    });
    if (reduceMotion) drawStatic();
  }

  function colorFor(k: number, alpha: number) {
    if (k === 0) return rgba(accent, alpha);
    if (k === 1) return `rgba(255, 255, 255, ${alpha})`;
    return rgba(accent, alpha * 0.45);
  }

  function drawStatic() {
    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = 'rgba(255, 255, 255, 0.2)';
    for (const p of points) {
      ctx.beginPath();
      ctx.arc(p.hx, p.hy, 1.5, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  function frame(now: number) {
    ctx.clearRect(0, 0, w, h);
    pointer.fade += ((pointer.active ? 1 : 0) - pointer.fade) * 0.08;

    const centers = Array.from({ length: K }, (_, k) => {
      const a = (k / K) * Math.PI * 2 + now * 0.0004;
      return { x: pointer.x + Math.cos(a) * ORBIT, y: pointer.y + Math.sin(a) * ORBIT };
    });

    for (const p of points) {
      const dx = p.hx - pointer.x;
      const dy = p.hy - pointer.y;
      const near = pointer.active && dx * dx + dy * dy < RADIUS * RADIUS;

      let tx = p.hx + Math.cos(now * p.speed + p.phase) * 14;
      let ty = p.hy + Math.sin(now * p.speed * 0.8 + p.phase) * 14;
      let cluster = 0;

      if (near) {
        let best = Infinity;
        centers.forEach((c, k) => {
          const d = (c.x - p.x) ** 2 + (c.y - p.y) ** 2;
          if (d < best) {
            best = d;
            cluster = k;
          }
        });
        tx = centers[cluster].x + p.ox;
        ty = centers[cluster].y + p.oy;
      }

      p.x += (tx - p.x) * 0.07;
      p.y += (ty - p.y) * 0.07;
      p.mix += ((near ? 1 : 0) - p.mix) * 0.08;

      const base = 0.2 + p.mix * 0.7;
      ctx.fillStyle = p.mix > 0.05 ? colorFor(cluster, base) : `rgba(255, 255, 255, ${base})`;
      ctx.beginPath();
      ctx.arc(p.x, p.y, 1.5 + p.mix * 1.1, 0, Math.PI * 2);
      ctx.fill();
    }

    if (pointer.fade > 0.02) {
      ctx.strokeStyle = `rgba(255, 255, 255, ${pointer.fade * 0.5})`;
      ctx.lineWidth = 1;
      for (const c of centers) {
        ctx.beginPath();
        ctx.moveTo(c.x - 4, c.y);
        ctx.lineTo(c.x + 4, c.y);
        ctx.moveTo(c.x, c.y - 4);
        ctx.lineTo(c.x, c.y + 4);
        ctx.stroke();
      }
    }

    requestAnimationFrame(frame);
  }

  readAccent();
  resize();
  window.addEventListener('resize', resize);
  window.addEventListener('accentchange', () => {
    readAccent();
    if (reduceMotion) drawStatic();
  });

  if (!reduceMotion) {
    const move = (e: PointerEvent) => {
      pointer.x = e.clientX;
      pointer.y = e.clientY;
      pointer.active = true;
    };
    window.addEventListener('pointermove', move);
    window.addEventListener('pointerdown', move);
    window.addEventListener('pointerup', (e) => {
      if (e.pointerType !== 'mouse') pointer.active = false;
    });
    window.addEventListener('pointercancel', () => (pointer.active = false));
    document.documentElement.addEventListener('mouseleave', () => (pointer.active = false));
    requestAnimationFrame(frame);
  }
</script>
